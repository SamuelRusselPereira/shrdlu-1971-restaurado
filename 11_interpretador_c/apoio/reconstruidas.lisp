(COMMENT FUNCOES QUE SO EXISTEM COMPILADAS NA IMAGEM MOBY E NAO TEM FONTE EM LUGAR NENHUM)
(COMMENT RECONSTRUIDAS AQUI A PARTIR DOS MACROS DE XCOMP.1 E DO FORMATO DAS TRANSCRICOES DO ITS)
(DEFUN FE (X) (CAAR X))
(DEFUN NB (X) (CADAR X))
(DEFUN N (X) (CADDAR X))
(DEFUN DPRINT2 (X) (COND ((GREATERP CHRCT (ADD1 (FLATSIZE X))) (PRINC (QUOTE / ))) (T (TERPRI) (PRINC (QUOTE /  )))) (PRINC X))
(DEFUN DPRINC (X) (COND ((GREATERP CHRCT (FLATSIZE X))) (T (TERPRI) (PRINC (QUOTE /  )))) (PRINC X))
(DEFUN DPRINT3 (X) (COND ((GREATERP CHRCT (ADD1 (FLATSIZE X)))) (T (TERPRI) (PRINC (QUOTE /  )))) (PRINC X) (PRINC (QUOTE / )))
(DEFUN DPRINT (X) (TERPRI) (PRINC X))
(DEFUN FEXPR DSAY (L) (MAPC (FUNCTION DPRINT2) L))
(DEFUN PRINT2 (X) (COND ((GREATERP CHRCT (FLATSIZE X)) (PRINC (QUOTE / ))) (T (TERPRI))) (PRINC X))
(DEFUN PRINT3 (X) (PROG2 (OR (GREATERP CHRCT (FLATSIZE X)) (TERPRI)) (PRINC X) (PRINC (QUOTE / ))))
(DEFUN PUTPROP1 (A B C) (PUTPROP A B C))
