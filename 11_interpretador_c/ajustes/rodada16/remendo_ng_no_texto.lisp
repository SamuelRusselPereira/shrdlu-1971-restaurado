(COMMENT REMENDO DA GRAMATICA PUBLICADO NA RODADA 16 DO EMULADOR (REMENDO_NG LISP QUE MUDA DUAS PALAVRAS DO CODIGO COMPILADO NOS ENDERECOS OCTAIS 257064 E 254030) AQUI FEITO NO TEXTO DA GRAMATICA EM VEZ DO CODIGO DE MAQUINA NOS DOIS LUGARES O TESTE (NQ PRONREL) VIRA (NQ REL) NO COMECO DO PROGRAMA NG E NO OBJETO DO VERBO COM PARTICULA NO PROGRAMA CLAUSE PARA QUE O THAT DEMONSTRATIVO NAO SEJA LIDO COMO PRONOME INTERROGATIVO)
(DEFUN RM-TROCA (X VELHO NOVO)
       (COND ((ATOM X) 0)
	     (T (PLUS (COND ((EQUAL (CAR X) VELHO) (RPLACA X NOVO) 1)
			    (T (RM-TROCA (CAR X) VELHO NOVO)))
		      (RM-TROCA (CDR X) VELHO NOVO)))))
(PRINT (LIST (QUOTE REMENDO-NG)
	     (RM-TROCA (GET (QUOTE NG) (QUOTE EXPR)) (QUOTE (OR (NQ QDET) (NQ PRONREL))) (QUOTE (OR (NQ QDET) (NQ REL))))
	     (RM-TROCA (GET (QUOTE CLAUSE) (QUOTE EXPR)) (QUOTE (OR (NQ PRONREL) (NQ QADJ))) (QUOTE (OR (NQ REL) (NQ QADJ))))))
