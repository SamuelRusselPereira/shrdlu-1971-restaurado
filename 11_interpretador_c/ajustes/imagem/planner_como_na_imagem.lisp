(COMMENT F31 MICRO PLANNER COMO ESTA COMPILADO NA IMAGEM MOBY DUMP DE 1971 E NAO COMO NO TEXTO PLNR 176 A IMAGEM FOI MONTADA COM OUTRA VERSAO DO MICRO PLANNER QUE NAO TEM O MECANISMO THMESSAGE DO PLNR 176 PARA THFAIL ESTE ARQUIVO NAO ALTERA PLNR 176 NEM OS ARQUIVOS Z SO TROCA TRES FUNCOES DEPOIS DA CARGA)

(COMMENT THVAL DA IMAGEM ENDERECOS OCTAIS 245301 A 245431 LIGA THTREE THVALUE THBRANCH THOLIST THABRANCH THE THV NAO LIGA NEM TESTA THMESSAGE E EM GO1 TESTA THINF PRIMEIRO E SE THINF NAO FOR NIL VAI PARA FAIL)
(DEFUN THVAL (THEXP THALIST)
       (THPUSH THLEVEL (LIST THTREE THALIST))
       (PROG (THTREE THVALUE THBRANCH THOLIST THABRANCH THE THV)
	     (SETQ THV (QUOTE (THV THNV)))
	GO   (SETQ THE THEXP)
	     (SETQ THEXP NIL)
	     (COND (^A (SETQ ^A NIL)
		       (OR (THERT ^A - THVAL) (GO FAIL))))
	     (COND ((ERRSET (SETQ THVALUE (EVAL THE))))
		   (T (PRINT THE)
		      (SETQ THVALUE (THERT LISPERROR - THVAL))))
	GO1  (COND (THINF (GO FAIL))
		   (THEXP (GO GO))
		   (THVALUE (GO SUCCEED))
		   (T (GO FAIL)))
	SUCCEED
	     (COND ((NULL THTREE) (SETQ THLEVEL (CDR THLEVEL))
				  (RETURN THVALUE)))
	     (COND ((NULL THBRANCH) (SETQ THBRANCH THTREE)
				    (SETQ THABRANCH THALIST)))
	     (COND ((SETQ THEXP (GET (CAAR THTREE) (QUOTE THSUCCEED)))
		    (GO GO2))
		   ((THERT BAD SUCCEED - THVAL) (GO SUCCEED))
		   ((GO FAIL)))
	FAIL (COND ((NULL THTREE) (SETQ THLEVEL (CDR THLEVEL))
				  (RETURN NIL))
		   ((SETQ THEXP (GET (CAAR THTREE) (QUOTE THFAIL)))
		    (GO GO2))
		   ((THERT BAD FAIL - THVAL) (GO SUCCEED))
		   ((GO FAIL)))
	GO2  (SETQ THVALUE ((PROG2 0 THEXP (SETQ THEXP NIL))))
	     (GO GO1)))

(COMMENT THFAIL DA IMAGEM ENDERECOS OCTAIS 241117 A 241225 PERCORRE A ARVORE THTREE DO TOPO PARA BAIXO E NAO MARCA THMESSAGE PARA AS ENTRADAS DOS TIPOS DA LISTA OCTAL 167555 THMUNG THPROG THAND THASSERT THERASE THREMBIND THDO THUNDO CHAMA O TRATADOR DE FALHA DO TIPO E AS OUTRAS SAO DESEMPILHADAS COM THPOPT AO ACHAR O TIPO PEDIDO DESEMPILHA ESSA ENTRADA E DEVOLVE NIL COMO O TRATADOR THPROGF RESTAURA O ULTIMO RAMO GUARDADO O THFAIL THGOAL DENTRO DE UM TEOREMA ACABA DESCARTANDO O ULTIMO SUBOBJETIVO E NAO O OBJETIVO QUE CHAMOU O TEOREMA)
(DEFUN THFAIL FEXPR (THA)
       (AND THA
	    (PROG NIL
		  (COND ((EQ (CAR THA) (QUOTE THEOREM))
			 (SETQ THA (CONS (QUOTE THPROG) (CDR THA))))
			((EQ (CAR THA) (QUOTE THINF))
			 (SETQ THINF T)
			 (RETURN NIL)))
	     LP   (COND ((NULL THTREE)
			 (PRINT THA)
			 (THERT OVERPOP - THFAIL)
			 (RETURN NIL))
			((EQ (CAAR THTREE) (CAR THA))
			 (COND ((EQ (CAR THA) (QUOTE THTAG))
				(COND ((EQ (CADR THA) (CADAR THTREE))
				       (COND ((CDDR THA) (RETURN (CADDR THA))))
				       (THPOPT)
				       (RETURN NIL)))
				(THPOPT)
				(GO LP))
			       ((EQ (CAR THA) (QUOTE THMESSAGE))
				(RETURN (THMESSAGEP (CADR THA)))))
			 (THPOPT)
			 (RETURN NIL))
			((MEMQ (CAAR THTREE)
			       (QUOTE (THMUNG THPROG THAND THASSERT THERASE THREMBIND THDO THUNDO)))
			 (APPLY (GET (CAAR THTREE) (QUOTE THFAIL)) NIL))
			(T (THPOPT)))
		  (GO LP))))

(COMMENT THGOALF DA IMAGEM ENDERECO OCTAL 241757 IGUAL AO PLNR 176 MAS SEM O TESTE DE THMESSAGE)
(DEFUN THGOALF NIL (COND ((THTRY1)) (T (THPOPT) NIL)))

(COMMENT ESTADO INICIAL DAS VARIAVEIS USADAS ACIMA)
(SETQ THINF NIL)
(SETQ THMESSAGE NIL)
