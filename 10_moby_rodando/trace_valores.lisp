(DEFUN TRCALLV (TRF TRA) (PROG (TRV) (PRINT (CONS (QUOTE >) (CONS TRF TRA))) (SETQ TRV (APPLY (GET TRF (QUOTE TREXPR)) TRA)) (PRINT (LIST (QUOTE <) TRF TRV)) (RETURN TRV)))
(DEFUN TRV (F) (PROG (D) (SETQ D (GET F (QUOTE EXPR))) (COND ((OR (NULL D) (GET F (QUOTE TREXPR)) (AND (CADR D) (ATOM (CADR D)))) (RETURN NIL))) (PUTPROP F D (QUOTE TREXPR)) (PUTPROP F (LIST (QUOTE LAMBDA) (CADR D) (LIST (QUOTE TRCALLV) (LIST (QUOTE QUOTE) F) (CONS (QUOTE LIST) (CADR D)))) (QUOTE EXPR)) (RETURN F)))
